{
  "buildCommand": null,
  "outputDirectory": "privacy-policy",
  "rewrites": [
    {
      "source": "/data-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
